<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p %c{1}:%L - %m%n"/>
		</Console>
	</Appenders>
	<SpringProfile name="production, test">
		<Loggers>
			<Logger name="org.springframework.boot.logging.log4j2" level="TRACE" additivity="false">
				<AppenderRef ref="Console"/>
			</Logger>
			<Root level="ERROR">
				<AppenderRef ref="Console"/>
			</Root>
		</Loggers>
	</SpringProfile>
</Configuration>
